# ========================================================
# cPanel Routing Configuration for Hitachi Solution Center
# Routes API requests to PHP API and all other routes to React SPA index.html
# ========================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route /api/* requests directly to PHP API backend
  RewriteRule ^api/(.*)$ api/index.php?endpoint=$1 [QSA,L]

  # 2. Serve existing static files (CSS, JS, Images, SVGs)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback all React SPA page routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>
